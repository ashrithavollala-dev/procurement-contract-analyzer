# Copy to .env (git-ignored) and adjust. Read by `docker compose`; every value also has a default
# in docker-compose.yml. No real secrets belong in this file.

# ---- Host ports (chosen to avoid 5432/5433/8080/5173/5174 used by other local projects) --------
POSTGRES_HOST_PORT=5434
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5175

# ---- Database (this project's own pgvector container only) -------------------------------------
DB_NAME=contract_analyzer
DB_USER=analyzer
DB_PASSWORD=replace_with_a_local_development_password
PG_SHARED_BUFFERS=128MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=50

# ---- HikariCP connection pool -----------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_CONNECTION_TIMEOUT_MS=10000
HIKARI_IDLE_TIMEOUT_MS=300000
HIKARI_MAX_LIFETIME_MS=1200000
HIKARI_LEAK_DETECTION_MS=20000

# ---- Uploads -----------------------------------------------------------------------------------
# Inside Docker the upload directory is the named volume mounted at /data/uploads.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_FILE_SIZE=25MB
UPLOAD_MAX_REQUEST_SIZE=26MB
UPLOAD_MAX_PAGES=200

# ---- LLM (chat) provider: ollama (default, local, free) or openai ---------------------------------
LLM_PROVIDER=ollama
# Ollama runs on the HOST. From inside the backend container it is reached via host.docker.internal.
# (A host-run backend uses http://localhost:11434 by default and does not read this file.)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_READ_TIMEOUT_SECONDS=300
# OpenAI: set LLM_PROVIDER=openai and provide your own key and a model you have access to.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Leave empty for models that reject the temperature parameter.
OPENAI_TEMPERATURE=0.0
LLM_MAX_CONCURRENT_CALLS=1
# rag (default; reliable with small models) or tools (bounded tool-calling agent)
QA_MODE=rag

# ---- Embeddings (always local ONNX all-MiniLM-L6-v2, 384 dims; first start downloads ~80 MB) -----
EMBEDDING_BATCH_SIZE=32

# ---- Executors ---------------------------------------------------------------------------------
INGESTION_CORE_POOL_SIZE=2
INGESTION_MAX_POOL_SIZE=4
INGESTION_QUEUE_CAPACITY=25
AUDIT_CORE_POOL_SIZE=1
AUDIT_MAX_POOL_SIZE=1
AUDIT_QUEUE_CAPACITY=5

# ---- Chunking (estimated tokens) ----------------------------------------------------------------
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
CHUNK_MIN_TOKENS=60

# ---- Agent limits ------------------------------------------------------------------------------
AGENT_TOP_K=6
AGENT_MAX_ITERATIONS=2
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_RULE_TIMEOUT_SECONDS=240

# ---- Recovery / misc ---------------------------------------------------------------------------
RECOVERY_STUCK_THRESHOLD=0s
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5176

# ---- Container memory (7.7 GB laptop friendly) -------------------------------------------------
JAVA_MAX_RAM_PERCENTAGE=60
BACKEND_MEM_LIMIT=1536m
POSTGRES_MEM_LIMIT=512m
FRONTEND_MEM_LIMIT=128m
