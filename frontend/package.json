{
  "name": "contract-analyzer-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "React UI for the Agentic Procurement Contract Analyzer (talks to the backend only through /api/v1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5176 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "5.104.2",
    "axios": "1.20.0",
    "lucide-react": "1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
